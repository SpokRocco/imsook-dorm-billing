# ==========================================================
# Dormitory Billing System ("หอพักอิ่มสุข") — Environment Template
# Copy to `.env.local` for local dev OR configure these keys in
# Vercel Project Settings -> Environment Variables (Production & Preview)
# ==========================================================

# Supabase Backend Credentials (Server / Vercel Functions)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-service-key

# Vite Frontend Variables (Public Config only — never put private service_role keys here)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your-supabase-publishable-key

# Mobile / Capacitor API Base URL (leave empty on Web/Vercel; set to https://your-app.vercel.app before `npm run cap:sync`)
VITE_API_BASE_URL=

# Optional comma-separated extra CORS origins (in addition to capacitor://localhost, http://localhost, *.vercel.app)
ALLOWED_ORIGINS=

# Local Express Backend Port (used locally by server/index.js & vite proxy; Vercel ignores this automatically)
PORT=3045
